let rewardPayload = null;

function loadGPTScript(callback) {
  const script = document.createElement("script");
  script.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";
  script.async = true;
  script.onload = callback;
  document.head.appendChild(script);
}

function updateStatus(message) {
  console.log("updateStatus:", message);
}

const navigationEntries = performance.getEntriesByType("navigation");
if (navigationEntries.length > 0 && navigationEntries[0].type === "reload") {
  console.log("Clearing sessionStorage after reload.");
  sessionStorage.removeItem("adShown");
}

loadGPTScript(() => {
  window.googletag = window.googletag || { cmd: [] };

  googletag.cmd.push(() => {
    let rewardedSlot = null;

    function setupRewardedAd(targetUrl) {
      rewardPayload = null;
      rewardedSlot = googletag.defineOutOfPageSlot(
        "23371784599/quizfev.com_reward",
        googletag.enums.OutOfPageFormat.REWARDED
      );

      if (rewardedSlot) {
        rewardedSlot.addService(googletag.pubads());
        googletag.enableServices();
        googletag.display(rewardedSlot);
      } else {
        updateStatus("Rewarded ads not supported.");
        window.location.href = targetUrl;
      }

      googletag.pubads().addEventListener("rewardedSlotReady", (event) => {
        try {
          event.makeRewardedVisible();
          updateStatus("Rewarded ad is active.");
        } catch (err) {
          console.error("makeRewardedVisible error:", err);
        }
      });

      googletag.pubads().addEventListener("rewardedSlotClosed", () => {
        if (rewardPayload) {
          window.location.href = targetUrl;
        } else {
          updateStatus("Ad closed without reward.");
        }
      });

      googletag.pubads().addEventListener("rewardedSlotGranted", (event) => {
        rewardPayload = event.payload;
        updateStatus("Reward granted.");
      });

      googletag.pubads().addEventListener("slotRenderEnded", (event) => {
        if (event.slot === rewardedSlot && event.isEmpty) {
          updateStatus("No ad returned.");
          window.location.href = targetUrl;
        }
      });
    }

    document.querySelectorAll(".watchAdButton").forEach((button) => {
      button.onclick = () => {
        const targetUrl = button.getAttribute("data-target");
        setupRewardedAd(targetUrl);
      };
    });
  });
});